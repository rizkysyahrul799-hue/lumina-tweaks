# Sembunyikan bahasa pendukung
*.sh linguist-vendored
*.c linguist-vendored
*.h linguist-vendored
*.js linguist-vendored
*.css linguist-vendored
*.html linguist-vendored

# Pangkas byte Vue dengan menyembunyikan folder components
webui/src/components/** linguist-vendored

# Pastikan C++ & sisa Vue terdeteksi penuh
*.cpp linguist-detectable=true
*.cpp linguist-vendored=false
webui/src/App.vue linguist-detectable=true
webui/src/views/** linguist-detectable=true
